rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Permite descarga pública del instalador
    match /DerbyManager.msix {
      allow read: if true;
      allow write: if request.auth != null;
    }
    // Todo lo demás requiere autenticación
    match /{allPaths=**} {
      allow read, write: if request.auth != null;
    }
  }
}
