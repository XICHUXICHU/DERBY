rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /Licenses/{codigo} {
      allow read: if true;
      allow update: if resource.data.hardware_id == ""
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hardware_id'])
                    && request.resource.data.hardware_id != "";
      allow create: if request.auth != null;
      allow delete: if false;
    }

    // Telemetría: la app puede crear eventos, nadie puede leer/editar sin auth
    match /app_events/{eventId} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }
  }
}
